# ─── GATEWAY ────────────────────────────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=      # Token d'authentification du Gateway (généré avec openssl rand -hex 32)

# Tokens Telegram
TELEGRAM_BOT_TOKEN=        # Token généré via @BotFather
TELEGRAM_CHAT_ID=         # Votre chat_id personnel
TELEGRAM_WEBHOOK_URL=       # optionnel — laisser vide pour le mode polling (recommandé)

# ─── PERSO — Posteo ───────────────────────────────────────────────────────────────────
# Générer un mot de passe d'application sur :
# https://posteo.de/fr/aide/comment-configurer-un-mot-de-passe-dapplication
MAIL_ADDRESS=           # ex: prenom.nom@posteo.de
MAIL_APP_PASSWORD=         # mot de passe d'application Posteo

IMAP_HOST=posteo.de
IMAP_PORT=993
IMAP_SSL=true

SMTP_HOST=posteo.de
SMTP_PORT=587
SMTP_STARTTLS=true

# Agenda — Posteo CalDAV (mêmes identifiants que le mail)
CALDAV_HOST=https://posteo.de:8443

# Contacts — Posteo CardDAV (mêmes identifiants que le mail)
CARDDAV_HOST=https://posteo.de:8843

# ─── SYNDICAL — Boîte fédérale (IMAP/SMTP) ────────────────────────────────────────────
SYNDICAL_A_ADDRESS=       # ex: prenom.nom@votre-federation.org
SYNDICAL_A_PASSWORD=      # mot de passe de la boite

SYNDICAL_A_IMAP_HOST=      # à renseigner selon config du serveur
SYNDICAL_A_IMAP_PORT=993
SYNDICAL_A_SMTP_HOST=      # à renseigner selon config du serveur
SYNDICAL_A_SMTP_PORT=587

# ─── SYNDICAL — Boîte confédérale (Exchange EWS) ────────────────────────────────
# IMAP/SMTP interdits — protocole obligatoire : EWS (Exchange Web Services)
# La connexion se fait par autodiscovery à partir de l'adresse email.
# Renseigner SYNDICAL_B_EWS_URL uniquement si l'autodiscovery échoue.
SYNDICAL_B_ADDRESS=       # ex: prenom.nom@votre-confederation.org
SYNDICAL_B_PASSWORD=       # mot de passe du compte Exchange
SYNDICAL_B_EWS_URL=       # optionnel — ex: https://mail.votre-confederation.org/EWS/Exchange.asmx

# ─── NOTION ───────────────────────────────────────────────────────────────────────────────
# Créer une intégration sur https://www.notion.so/my-integrations
# puis partager chaque base de données avec cette intégration
NOTION_TOKEN=           # secret_xxxx

# IDs des bases de données (visibles dans l'URL Notion de chaque base)
NOTION_DB_PERSO_ID=        # carnet de notes perso
NOTION_DB_SYNDICAL_ID=       # carnet de notes syndicat
NOTION_DB_OPENCLAW_ID=       # carnet de notes openclaw

# ─── SAUVEGARDE ───────────────────────────────────────────────────────────────────────
BACKUP_DEST=            # ex: /mnt/backup ou rclone:bucket/openclaw
BACKUP_GPG_PASSPHRASE=       # passphrase GPG AES256 pour le chiffrement des archives (obligatoire)

# ─── SERVICES OPTIONNELS ──────────────────────────────────────────────────────────────
# Laisser vide si le service n'est pas utilisé

OPENWEATHER_API_KEY=        # optionnel — clé API OpenWeatherMap pour la météo du brief matin
                  # Obtenir sur : https://openweathermap.org/api

# ─── SYSTEM-ENGINEER ───────────────────────────────────────────────────────────────────
SYS_VENV_PATH=/opt/openclaw/venv     # Chemin du venv Python OpenClaw
SYS_SCRIPTS_PATH=/opt/openclaw/scripts  # Chemin du dépôt git de scripts
SYS_TEST_PATH=/tmp/openclaw-test     # Répertoire de test isolé (temporaire)
SYS_DISK_ALERT_PERCENT=80        # Alerte disque à ce pourcentage d'occupation
SYS_DISK_BLOCK_PERCENT=95        # Bloquer les installations au-delà
